{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "OpenTelemetry": {
    "ApplicationInsights": {
      "ConnectionString": ""
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "UseHttps": true
      },
      "Hosting": {
        "Debug": false
      },
      "Security": {
        "AllowConcurrentLogins": false
      }
    }
  }
}
