@using ProgrammePulse.Models.Staff
@{
    var message = ViewData["Message"] as string;
    var roles = StaffRole.All;
}

<partial name="~/Views/StaffOps/Settings/_SettingsNav.cshtml" model="@("people")" />

@if (!string.IsNullOrWhiteSpace(message))
{
    <p class="ops-banner ops-banner--info" role="status" aria-live="polite">@message</p>
}

<section class="ops-panel">
    <h2 class="ops-panel__heading">Add Staff</h2>
    <p class="ops-empty-state">
        Creates the sign-in account and the staff profile together. The Admin sets an initial
        password here and shares it with the new starter directly — there is no invite email.
        Admin-role accounts are prompted to set up MFA automatically on first sign-in.
    </p>

    <form asp-controller="StaffAdmin" asp-action="Create" method="post" class="ops-filter-bar">
        <div class="ops-filter-bar__field">
            <label for="fullName">Full name</label>
            <input type="text" id="fullName" name="fullName" maxlength="256" required />
        </div>
        <div class="ops-filter-bar__field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" maxlength="256" autocomplete="off" required />
        </div>
        <div class="ops-filter-bar__field">
            <label for="password">Initial password</label>
            <input type="password" id="password" name="password" autocomplete="new-password" required />
        </div>
        <div class="ops-filter-bar__field">
            <label for="role">Role</label>
            <select id="role" name="role" required>
                @foreach (var role in roles)
                {
                    <option value="@role">@ProgrammePulse.Services.Shared.DisplayText.Words(role)</option>
                }
            </select>
        </div>
        <div class="ops-filter-bar__field">
            <label for="jobTitle">Job title</label>
            <input type="text" id="jobTitle" name="jobTitle" maxlength="256" />
        </div>
        <div class="ops-filter-bar__field">
            <label for="department">Department</label>
            <input type="text" id="department" name="department" maxlength="256" />
        </div>
        <div class="ops-filter-bar__field">
            <label for="team">Team</label>
            <input type="text" id="team" name="team" maxlength="256" />
        </div>
        <div class="ops-filter-bar__field">
            <label for="defaultWorkHoursPerWeek">Default hours/week</label>
            <input type="number" id="defaultWorkHoursPerWeek" name="defaultWorkHoursPerWeek" min="0" step="0.5" value="37.5" required />
        </div>
        <button type="submit" class="ops-button">Add staff</button>
    </form>
</section>
