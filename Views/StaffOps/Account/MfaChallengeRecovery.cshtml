@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Use a recovery code — @ProductBrand.Value.Name</title>
    <link rel="stylesheet" href="~/css/app.css" />
</head>
<body>
    <main class="ops-main ops-auth">
        <div class="ops-panel">
            <h1 class="ops-panel__heading">Use a recovery code</h1>
            <p>Enter one of the one-time recovery codes you saved when you set up your authenticator app.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <p class="ops-chip" role="alert">@ViewData.ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage</p>
            }

            <form asp-controller="StaffAccount" asp-action="MfaChallengeRecoveryVerify" method="post" class="ops-login-form">
                <div class="ops-filter-bar__field">
                    <label for="code">Recovery code</label>
                    <input type="text" id="code" name="code" autocomplete="one-time-code" placeholder="ABCDE-FGHJK" required autofocus />
                </div>
                <button type="submit" class="ops-button">Sign in</button>
            </form>

            <p><a asp-controller="StaffAccount" asp-action="MfaChallenge">Back to authenticator code entry</a></p>
        </div>
    </main>
</body>
</html>
