{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "OpenTelemetry": {
    "ApplicationInsights": {
      "ConnectionString": ""
    }
  },
  "Umbraco": {
    "CMS": {
      "Hosting": {
        "Debug": true
      }
    }
  },
  "ProgrammeOps": {
    "AllowSharedSourceCredentials": true
  },
  "Security": {
    "MfaCookieSecurePolicy": "SameAsRequest"
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Server=(localdb)\\GardnerDB;Database=UmbracoBase;Integrated Security=true;TrustServerCertificate=true;"
  }
}
